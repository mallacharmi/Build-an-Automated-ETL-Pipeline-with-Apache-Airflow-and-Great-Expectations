# ==============================================================================
# Environment Configuration Template for E-commerce Analytics ETL Pipeline
# Copy this file to '.env' and customize values for your deployment.
# ==============================================================================

# Airflow Host User ID (matches host user permissions on Linux/macOS)
AIRFLOW_UID=50000

# Base Docker image or custom build tag
AIRFLOW_IMAGE_NAME=apache/airflow:2.7.0-python3.10

# Airflow Core Configurations
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__CORE__DEFAULT_TIMEZONE=UTC
AIRFLOW__CORE__FERNET_KEY=46BKJoKc-Ctbbbqw_nRqqjAFWq0ikNjJngOjRbGw3QI=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow

# Airflow Admin User Credentials (for Webserver login)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
_AIRFLOW_WWW_USER_FIRSTNAME=Airflow
_AIRFLOW_WWW_USER_LASTNAME=Admin
_AIRFLOW_WWW_USER_EMAIL=admin@example.com

# PostgreSQL Metadata Database Credentials
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_PORT=5432

# Pipeline Data & Storage Directories
DATA_DIR=/opt/airflow/data
GREAT_EXPECTATIONS_DIR=/opt/airflow/great_expectations

# Remote Dataset Ingestion URL (UCI E-commerce Dataset)
DATASET_URL=https://raw.githubusercontent.com/databricks/Spark-The-Definitive-Guide/master/data/retail-data/by-day/2010-12-01.csv

# SQLite Analytical Query Store Path
SQLITE_DB_PATH=/opt/airflow/data/analytics.db
